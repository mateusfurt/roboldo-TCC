# Chave de API do Google Gemini (Obrigatória)
GOOGLE_API_KEY=sua_chave_da_google_aqui

# Configurações de Comunicação Serial com ESP32 (Opcional - padrões abaixo)
# No Linux: /dev/ttyACM0 ou /dev/ttyUSB0
# No Windows: COM3, COM4, etc.
SERIAL_PORT=/dev/ttyACM0
BAUD_RATE=115200

# Modelo do Google Gemini (Opcional)
GEMINI_MODEL=gemini-2.5-flash-lite

